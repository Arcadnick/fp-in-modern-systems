// Структуры данных после изменений. Сборка: dot -Tsvg data-after.dot -o data-after.svg
digraph data {
  label="Структуры данных: после изменений"; labelloc=t; fontsize=18; fontname="Helvetica";
  rankdir=TB; nodesep=0.5; ranksep=0.6;
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#555555"];

  Catalog [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#dbe8f8" COLOR="#2463a8">
    <TR><TD BGCOLOR="#2463a8"><FONT COLOR="white"><B>Catalog</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT">films: Playlist (только внутри)<BR ALIGN="LEFT"/>viewers: tuple[Viewer]<BR ALIGN="LEFT"/></TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">барьер абстракций: 22 метода для слоёв выше<BR ALIGN="LEFT"/>(is_empty, film_at, viewer_names, watch, rate,<BR ALIGN="LEFT"/>statistics → Statistics, ...);<BR ALIGN="LEFT"/>Playlist наружу не выдаётся<BR ALIGN="LEFT"/></FONT></TD></TR>
  </TABLE>>];

  Playlist [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#dbe8f8" COLOR="#2463a8">
    <TR><TD BGCOLOR="#2463a8"><FONT COLOR="white"><B>Playlist</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT">cinema: tuple[Cinematography]<BR ALIGN="LEFT"/></TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">минимальный интерфейс, 8 методов:<BR ALIGN="LEFT"/>__iter__, __len__, at, filtered,<BR ALIGN="LEFT"/>sorted_with, replaced, unique_by<BR ALIGN="LEFT"/></FONT></TD></TR>
  </TABLE>>];

  Viewer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#dbe8f8" COLOR="#2463a8">
    <TR><TD BGCOLOR="#2463a8"><FONT COLOR="white"><B>Viewer</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT">name: str<BR ALIGN="LEFT"/>favorite_genres: tuple[str]<BR ALIGN="LEFT"/>history: tuple[название]<BR ALIGN="LEFT"/>ratings: dict[название, оценка]<BR ALIGN="LEFT"/>playlist: tuple[название]<BR ALIGN="LEFT"/></TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">5 методов: has_watched, watched,<BR ALIGN="LEFT"/>rated, with_in_playlist<BR ALIGN="LEFT"/></FONT></TD></TR>
  </TABLE>>];

  Cinematography [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#dbe8f8" COLOR="#2463a8">
    <TR><TD BGCOLOR="#2463a8"><FONT COLOR="white"><B>Cinematography</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT">title, director, genre: str<BR ALIGN="LEFT"/>release: int (1895..2026)<BR ALIGN="LEFT"/>rating: int (1..10)<BR ALIGN="LEFT"/>views: int<BR ALIGN="LEFT"/>votes: tuple[int]<BR ALIGN="LEFT"/>FIELDS = (title, director, genre,<BR ALIGN="LEFT"/>          release, rating)<BR ALIGN="LEFT"/></TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">только данные и copy-on-write:<BR ALIGN="LEFT"/>with_view, with_vote, with_raised_rating,<BR ALIGN="LEFT"/>can_raise_rating<BR ALIGN="LEFT"/></FONT></TD></TR>
  </TABLE>>];

  Film [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#dbe8f8" COLOR="#2463a8">
    <TR><TD BGCOLOR="#2463a8"><FONT COLOR="white"><B>Film</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT">budget: int &gt; 0<BR ALIGN="LEFT"/>effect: Yes | No<BR ALIGN="LEFT"/>FIELDS += (budget, effect)<BR ALIGN="LEFT"/></TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">только проверки полей<BR ALIGN="LEFT"/></FONT></TD></TR>
  </TABLE>>];

  Cartoon [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#dbe8f8" COLOR="#2463a8">
    <TR><TD BGCOLOR="#2463a8"><FONT COLOR="white"><B>Cartoon</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT">character: str<BR ALIGN="LEFT"/>kind: Short | Full | Serial<BR ALIGN="LEFT"/>FIELDS += (character, kind)<BR ALIGN="LEFT"/></TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">только проверки полей<BR ALIGN="LEFT"/></FONT></TD></TR>
  </TABLE>>];

  Serial [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#dbe8f8" COLOR="#2463a8">
    <TR><TD BGCOLOR="#2463a8"><FONT COLOR="white"><B>Serial</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT">series: int &gt; 0<BR ALIGN="LEFT"/>seasons: int &gt; 0<BR ALIGN="LEFT"/>FIELDS += (series, seasons)<BR ALIGN="LEFT"/></TD></TR>
    <TR><TD ALIGN="LEFT"><FONT COLOR="#555555">только проверки полей<BR ALIGN="LEFT"/></FONT></TD></TR>
  </TABLE>>];

  Statistics [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e3f2e6" COLOR="#1e8449">
    <TR><TD BGCOLOR="#1e8449"><FONT COLOR="white"><B>Statistics</B> (NamedTuple, новая)</FONT></TD></TR>
    <TR><TD ALIGN="LEFT">by_genre: dict[жанр, средний рейтинг]<BR ALIGN="LEFT"/>top: list[Cinematography]<BR ALIGN="LEFT"/>most_viewed: Cinematography | None<BR ALIGN="LEFT"/>total_views: int<BR ALIGN="LEFT"/>viewer_count: int<BR ALIGN="LEFT"/></TD></TR>
  </TABLE>>];

  Comparison [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e3f2e6" COLOR="#1e8449">
    <TR><TD BGCOLOR="#1e8449"><FONT COLOR="white"><B>Comparison</B> (NamedTuple, новая)</FONT></TD></TR>
    <TR><TD ALIGN="LEFT">better, worse: Cinematography<BR ALIGN="LEFT"/>equal: bool<BR ALIGN="LEFT"/></TD></TR>
  </TABLE>>];

  Catalog -> Statistics [label=" statistics()", style=dotted, arrowhead=vee];
  Statistics -> Cinematography [style=dotted, arrowhead=vee];
  Comparison -> Cinematography [style=dotted, arrowhead=vee];

  Catalog -> Playlist [label=" 1 : 1", dir=back, arrowtail=diamond];
  Catalog -> Viewer [label=" 1 : N", dir=back, arrowtail=diamond];
  Playlist -> Cinematography [label=" 1 : N", dir=back, arrowtail=diamond];
  Viewer -> Cinematography [label=" N : M по названию", style=dashed, arrowhead=vee];
  Cinematography -> Film [arrowhead=none, dir=back, arrowtail=empty];
  Cinematography -> Cartoon [arrowhead=none, dir=back, arrowtail=empty];
  Cartoon -> Serial [arrowhead=none, dir=back, arrowtail=empty];
}
